{
  "name": "photography-outreach",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @photography-outreach/database migrate",
    "db:seed": "pnpm --filter @photography-outreach/database seed",
    "db:generate": "pnpm --filter @photography-outreach/database generate"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
