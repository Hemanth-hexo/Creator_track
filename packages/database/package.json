{
  "name": "@photography-outreach/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "migrate": "dotenv -e ../../.env --no-expand -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env --no-expand -- prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "dotenv -e ../../.env --no-expand -- tsx src/seed.ts",
    "studio": "dotenv -e ../../.env --no-expand -- prisma studio",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@photography-outreach/shared": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
