{
  "name": "@photography-outreach/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env --no-expand -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env --no-expand -- node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@photography-outreach/ai": "workspace:*",
    "@photography-outreach/database": "workspace:*",
    "@photography-outreach/email": "workspace:*",
    "@photography-outreach/events": "workspace:*",
    "@photography-outreach/opportunities": "workspace:*",
    "@photography-outreach/research": "workspace:*",
    "@photography-outreach/shared": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
