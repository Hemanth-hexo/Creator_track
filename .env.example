# ---------------------------------------------------------------------------
# Photography Outreach CRM — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local Postgres started via `docker compose up -d`
DATABASE_URL="postgresql://outreach:outreach@localhost:5433/photography_outreach?schema=public"

# --- Auth --------------------------------------------------------------------
# Single-user login for the web dashboard. Generate a bcrypt hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH=""
# Random long string used to sign session cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=""
# Shared bearer token the MCP server / scripts use to call the API directly
API_TOKEN=""

# --- Event discovery ----------------------------------------------------------
# The MVP's default discovery provider is Tavily (search) + Groq (extraction)
# — packages/events/src/providers/tavily-groq.ts. Both have genuinely free
# tiers with no credit card required, unlike OpenAI's web_search tool.
# Configure what it searches for on the Settings page (discovery queries,
# e.g. "upcoming electronic music events in Bengaluru, India").

# Free API key, no card: https://tavily.com (sign up -> dashboard -> API key)
TAVILY_API_KEY=""
# Free API key, no card: https://console.groq.com/keys
GROQ_API_KEY=""
# Check https://console.groq.com/docs/models for the current free-tier model list if this one is retired.
GROQ_MODEL="openai/gpt-oss-120b"

# BANDSINTOWN_APP_ID is optional and legacy — only needed if you deliberately
# enable BandsintownProvider (an alternate EventProvider implementation kept
# to prove the abstraction works with more than one source; not used by
# default). Free app_id: https://artists.bandsintown.com/support/api-installation
BANDSINTOWN_APP_ID=""

# --- LLM provider (outreach email generation) ---------------------------------
# "anthropic", "openai", or "groq" — selects the model used for outreach
# EMAIL generation. Independent of event discovery above. "groq" reuses
# GROQ_API_KEY/GROQ_MODEL from the event discovery section — no separate
# signup needed if you're already using the free Tavily+Groq discovery path.
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
# Only required if LLM_PROVIDER=openai, or if you switch event discovery to
# the optional OpenAIWebSearchEventProvider (see defaultProvider.ts) — it
# needs a funded/paid OpenAI account, unlike the Tavily+Groq default above.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# --- Email sending: SMTP via your own Gmail / Google Workspace account -------
# Requires 2-Step Verification enabled on the account, then create an
# "App Password" at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# The "From" address/name used on outgoing outreach emails
EMAIL_FROM_NAME="Your Name Photography"
EMAIL_FROM_ADDRESS=""

# --- App ports -----------------------------------------------------------------
API_PORT="4000"
WEB_PORT="3000"
API_BASE_URL="http://localhost:4000"

# --- Misc ----------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"
